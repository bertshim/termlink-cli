{
  "name": "termlink-cli",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/terminal",
    "packages/host"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
